{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "stkodds",
          "appId": "1:92724783724:android:061ca970ff554574398649",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "stkodds",
          "appId": "1:92724783724:ios:420bc7e331f12bfa398649",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "stkodds",
          "configurations": {
            "android": "1:92724783724:android:061ca970ff554574398649",
            "ios": "1:92724783724:ios:420bc7e331f12bfa398649",
            "web": "1:92724783724:web:5e8e2d0eea54dcf7398649"
          }
        }
      }
    }
  }
}
